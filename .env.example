# KinSight environment
# Copy to .env.local and fill in. .env.local is gitignored — never commit a real key.

# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides. Defaults live in src/lib/gemini.ts.
# Fast path (call scoring, claim checks, transcription):
GEMINI_MODEL=gemini-3.8-flash
# Deep path (police report drafting):
GEMINI_MODEL_DEEP=gemini-pro-latest

# PostgreSQL connection string for scam reports and kin feedback.
# Run `npm run db:migrate` after setting this. Also configure DATABASE_URL in
# the Vercel project; .env.local is only used on your computer.
DATABASE_URL=
#
# Note: gemini-2.5-* is retired for new keys. Run
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
# to see what your key can actually call.
